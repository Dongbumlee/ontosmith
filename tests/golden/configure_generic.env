# OntoSmith seat bindings — where each model seat points.
# Written by `ontosmith configure`; safe to edit by hand and
# re-validate with `ontosmith configure --from-file <file>`.
# Keys are referenced by variable NAME only — no key value
# ever appears in this file. Load it before running:
#   set -a; . ./ontosmith-bindings.env; set +a
# Binding: custom
# Validation: not probed (--no-probe)

ONTOSMITH_PROPOSER_BASE_URL="https://api.example.com/v1"
ONTOSMITH_PROPOSER_MODEL="acme/proposer-x"
ONTOSMITH_PROPOSER_KEY_ENV="LLM_API_KEY"
ONTOSMITH_PROPOSER_DIALECT="openai"

ONTOSMITH_JUDGE_BASE_URL="https://api.example.com/v1"
ONTOSMITH_JUDGE_MODEL="acme/judge-x"
ONTOSMITH_JUDGE_KEY_ENV="LLM_API_KEY"
ONTOSMITH_JUDGE_DIALECT="openai"
ONTOSMITH_JUDGE_DECISIONS_URL="https://api.example.com/v1/decisions"

ONTOSMITH_ESCALATION_BASE_URL="https://api.example.com/v1"
ONTOSMITH_ESCALATION_MODEL="acme/esc-x"
ONTOSMITH_ESCALATION_KEY_ENV="LLM_API_KEY"
ONTOSMITH_ESCALATION_DIALECT="openai"
ONTOSMITH_ESCALATION_DECISIONS_URL="https://api.example.com/v1/decisions"

ONTOSMITH_DRAFTING_BASE_URL="https://api.example.com/v1"
ONTOSMITH_DRAFTING_MODEL="acme/draft-x"
ONTOSMITH_DRAFTING_KEY_ENV="LLM_API_KEY"
ONTOSMITH_DRAFTING_DIALECT="openai"

ONTOSMITH_EMBEDDER_BASE_URL="https://api.example.com/v1"
ONTOSMITH_EMBEDDER_MODEL="acme/embed-x"
ONTOSMITH_EMBEDDER_KEY_ENV="LLM_API_KEY"
ONTOSMITH_EMBEDDER_DIALECT="openai"
