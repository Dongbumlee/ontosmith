# OntoSmith seat bindings — where each model seat points.
# Written by `ontosmith configure`; safe to edit by hand and
# re-validate with `ontosmith configure --from-file <file>`.
# Keys are referenced by variable NAME only — no key value
# ever appears in this file. Load it before running:
#   set -a; . ./ontosmith-bindings.env; set +a
# Binding: reference
# Validation: not probed (--no-probe)

ONTOSMITH_PROPOSER_BASE_URL="https://openrouter.ai/api/v1"
ONTOSMITH_PROPOSER_MODEL="anthropic/claude-haiku-5.5"
ONTOSMITH_PROPOSER_KEY_ENV="OPENROUTER_API_KEY"
ONTOSMITH_PROPOSER_DIALECT="openrouter"

ONTOSMITH_JUDGE_BASE_URL="https://openrouter.ai/api/v1"
ONTOSMITH_JUDGE_MODEL="typesafe/jev-1.13"
ONTOSMITH_JUDGE_KEY_ENV="OPENROUTER_API_KEY"
ONTOSMITH_JUDGE_DIALECT="openrouter"
ONTOSMITH_JUDGE_DECISIONS_URL="https://openrouter.ai/api/alpha/decisions"

ONTOSMITH_ESCALATION_BASE_URL="https://openrouter.ai/api/v1"
ONTOSMITH_ESCALATION_MODEL="anthropic/claude-sonnet-5.5"
ONTOSMITH_ESCALATION_KEY_ENV="OPENROUTER_API_KEY"
ONTOSMITH_ESCALATION_DIALECT="openrouter"
ONTOSMITH_ESCALATION_DECISIONS_URL="https://openrouter.ai/api/alpha/decisions"

# drafting seat: unbound — no model declared (drafting is disabled under this binding)

ONTOSMITH_EMBEDDER_BASE_URL="https://openrouter.ai/api/v1"
ONTOSMITH_EMBEDDER_MODEL="openai/text-embedding-3-large"
ONTOSMITH_EMBEDDER_KEY_ENV="OPENROUTER_API_KEY"
ONTOSMITH_EMBEDDER_DIALECT="openrouter"
