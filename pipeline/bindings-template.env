# OntoSmith seat bindings — TEMPLATE.
#
# The non-interactive door of `ontosmith configure`: copy this
# file, replace every <…> placeholder with your values, then run
#
#   ontosmith configure --from-file <your copy>
#
# which validates the declarations, runs the zero-spend probes,
# and rewrites the file in canonical form with its binding stamp.
# (`ontosmith configure` with no flags asks the same questions
# interactively and writes the identical file.)
#
# Keys are referenced by variable NAME only — write the NAME of
# the environment variable that holds your key, never the key
# itself. Load the finished file before running:
#   set -a; . ./ontosmith-bindings.env; set +a
#
# The example below points every seat at one provider of your
# own (an OpenAI-compatible base URL). Seats may diverge: give
# any seat its own BASE_URL / KEY_ENV / DIALECT lines.

# — proposer seat: writes the candidate triples —
ONTOSMITH_PROPOSER_BASE_URL="<your provider base URL, e.g. https://api.example.com/v1>"
ONTOSMITH_PROPOSER_MODEL="<proposer model id>"
ONTOSMITH_PROPOSER_KEY_ENV="<key variable name, e.g. LLM_API_KEY>"
ONTOSMITH_PROPOSER_DIALECT="openai"

# — judge seat: the Decision-Model seat (systemone route, or an
# alpha-protocol decisions route on your own base URL) —
ONTOSMITH_JUDGE_BASE_URL="<your provider base URL>"
ONTOSMITH_JUDGE_MODEL="<judge model id>"
ONTOSMITH_JUDGE_KEY_ENV="<key variable name>"
ONTOSMITH_JUDGE_DIALECT="openai"
ONTOSMITH_JUDGE_DECISIONS_URL="<decisions route URL, e.g. https://api.example.com/v1/decisions>"

# — escalation seat: the frontier chat model for hard calls —
ONTOSMITH_ESCALATION_BASE_URL="<your provider base URL>"
ONTOSMITH_ESCALATION_MODEL="<escalation model id>"
ONTOSMITH_ESCALATION_KEY_ENV="<key variable name>"
ONTOSMITH_ESCALATION_DIALECT="openai"
ONTOSMITH_ESCALATION_DECISIONS_URL="<decisions route URL>"

# — drafting seat: writes the draft ontology from a profile.
# OPTIONAL: to leave drafting unbound (its shipped state),
# delete this seat's MODEL line — an unbound seat is expressed
# by the absence of the model declaration. —
ONTOSMITH_DRAFTING_BASE_URL="<your provider base URL>"
ONTOSMITH_DRAFTING_MODEL="<drafting model id, or delete this line to leave drafting unbound>"
ONTOSMITH_DRAFTING_KEY_ENV="<key variable name>"
ONTOSMITH_DRAFTING_DIALECT="openai"

# — embedder seat: hosted embedding model —
ONTOSMITH_EMBEDDER_BASE_URL="<your provider base URL>"
ONTOSMITH_EMBEDDER_MODEL="<embedding model id>"
ONTOSMITH_EMBEDDER_KEY_ENV="<key variable name>"
ONTOSMITH_EMBEDDER_DIALECT="openai"

# Optional, per seat: declared rates turn token counts into
# ESTIMATED costs (cost_basis: estimated) — uncomment and fill
# to let a USD spend cap guard seats whose provider reports no
# cost of its own:
# ONTOSMITH_PROPOSER_PRICE_IN_PER_MTOK="<USD per million input tokens>"
# ONTOSMITH_PROPOSER_PRICE_OUT_PER_MTOK="<USD per million output tokens>"
#
# Optional, per seat: capability declarations (defaults derive
# from the model id; +/- entries adjust the derived set):
# ONTOSMITH_PROPOSER_CAPABILITIES="<e.g. no-temperature, reasoning-tokens>"
